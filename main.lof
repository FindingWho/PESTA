\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Time-domain waveform and corresponding spectrogram of a 20 Hz sinusoidal tone sweep. The waveform demonstrates clean periodicity with no DC offset, while the spectrogram confirms high-intensity energy capture at the 20 Hz frequency.}}{44}{figure.caption.42}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Time-domain waveform and corresponding spectrogram of a 50 Hz sinusoidal tone sweep. The waveform exhibits a stable amplitude envelope, while the spectrogram confirms a concentrated energy band at 50 Hz}}{45}{figure.caption.43}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Time-domain waveform and corresponding spectrogram of a 200 Hz sinusoidal tone sweep. The waveform demonstrates a stable amplitude envelope with a sudden high-amplitude surge, while the spectrogram reveals harmonic distortion bands at integer multiples of the fundamental frequency.}}{46}{figure.caption.44}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Time-domain waveform and corresponding spectrogram of an 1111 Hz sinusoidal tone test. The waveform demonstrates stable high-frequency acquisition, while the spectrogram confirms a continuous, clean energy band at 1111 Hz without attenuation or digital blindness.}}{47}{figure.caption.45}%
