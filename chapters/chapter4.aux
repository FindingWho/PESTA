\@writefile{toc}{\contentsline {section}{\numberline {4.1}System Characterization via Controlled Frequency Sweeps}{15}{section.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.1}Low-Frequency Biomedical Bandwidth Analysis (20 - 50 Hz)}{15}{subsection.4.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Time-domain waveform and corresponding spectrogram of a 20 Hz sinusoidal tone sweep. The waveform demonstrates clean periodicity with no DC offset, while the spectrogram confirms high-intensity energy capture at the 20 Hz frequency.}}{16}{figure.caption.19}\protected@file@percent }
\newlabel{fig:20hz_analysis}{{4.1}{16}{Time-domain waveform and corresponding spectrogram of a 20 Hz sinusoidal tone sweep. The waveform demonstrates clean periodicity with no DC offset, while the spectrogram confirms high-intensity energy capture at the 20 Hz frequency}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Time-domain waveform and corresponding spectrogram of a 50 Hz sinusoidal tone sweep. The waveform exhibits a stable amplitude envelope, while the spectrogram confirms a concentrated energy band at 50 Hz}}{17}{figure.caption.20}\protected@file@percent }
\newlabel{fig:50hz_analysis}{{4.2}{17}{Time-domain waveform and corresponding spectrogram of a 50 Hz sinusoidal tone sweep. The waveform exhibits a stable amplitude envelope, while the spectrogram confirms a concentrated energy band at 50 Hz}{figure.caption.20}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.2}Intermediate-Frequency Analysis (200 Hz)}{17}{subsection.4.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Time-domain waveform and corresponding spectrogram of a 200 Hz sinusoidal tone sweep. The waveform demonstrates a stable amplitude envelope with a sudden high-amplitude surge, while the spectrogram reveals harmonic distortion bands at integer multiples of the fundamental frequency.}}{18}{figure.caption.21}\protected@file@percent }
\newlabel{fig:200hz_analysis}{{4.3}{18}{Time-domain waveform and corresponding spectrogram of a 200 Hz sinusoidal tone sweep. The waveform demonstrates a stable amplitude envelope with a sudden high-amplitude surge, while the spectrogram reveals harmonic distortion bands at integer multiples of the fundamental frequency}{figure.caption.21}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.3}High-Frequency Analysis (1111 Hz)}{18}{subsection.4.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Time-domain waveform and corresponding spectrogram of an 1111 Hz sinusoidal tone test. The waveform demonstrates stable high-frequency acquisition, while the spectrogram confirms a continuous, clean energy band at 1111 Hz without attenuation or digital blindness.}}{19}{figure.caption.22}\protected@file@percent }
\newlabel{fig:1111hz_analysis}{{4.4}{19}{Time-domain waveform and corresponding spectrogram of an 1111 Hz sinusoidal tone test. The waveform demonstrates stable high-frequency acquisition, while the spectrogram confirms a continuous, clean energy band at 1111 Hz without attenuation or digital blindness}{figure.caption.22}{}}
